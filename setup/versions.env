# Tööriistade versioonid. Neid loevad install.sh, install.ps1 ja check.py.
# Muuda siin, mitte skriptides.

# ffmpeg conda-forge'ist, GPL-versioon (sisaldab libx264 kodeerijat)
FFMPEG_SPEC="ffmpeg[build=gpl*]"

# Node.js 22 (HyperFrames vajab vähemalt 22)
NODE_SPEC="nodejs>=22,<23"

# Deno: yt-dlp kasutab seda YouTube'i allalaadimisel vaikimisi
DENO_SPEC="deno"

# Git (HyperFramesi skillide paigaldus vajab seda; Windowsis pole Git for Windowsit vaja)
GIT_SPEC="git"

# yt-dlp koos yt-dlp-ejs lisaga
YTDLP_SPEC="yt-dlp[default]"

# Python, millega Whisperit käivitatakse
PYTHON_VERSION="3.12"

# HyperFramesi CLI versioon. "latest" = uusim.
# HyperFramesi ametlikud skillid kutsuvad alati "npx hyperframes" (uusim),
# seega lukustamine siin mõjutab ainult seadistust ja kontrolli.
HYPERFRAMES_VERSION="latest"
